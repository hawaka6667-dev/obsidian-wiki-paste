    { "x": "[[^abc]](https://regexone.com/lesson/excluding_characters \"Lesson 4: Excluding specific characters\")", "fx": "[\\[^abc\\]](https://regexone.com/lesson/excluding_characters \"Lesson 4: Excluding specific characters\")" },
